ENV=development
LOG_LEVEL=INFO

# Local dev default is SQLite (see app/core/config.py). Point this at
# PostgreSQL for anything beyond quick iteration:
# DATABASE_URL=postgresql+asyncpg://exchange:exchange@localhost:5432/exchange
DATABASE_URL=sqlite+aiosqlite:///./dev.db
DATABASE_ECHO=false

JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ALLOW_ORIGINS=http://localhost:5173

INITIAL_DEMO_BALANCE_MINOR=10000000
